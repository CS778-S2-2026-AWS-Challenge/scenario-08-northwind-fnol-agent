{
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "reason_codes", "field_changes", "contents_item_changes", "next_question", "service_suggestions", "state_proposals", "escalation", "ready_to_create", "confirms_batch"],
  "properties": {
    "reply": {"type": "string", "minLength": 1, "maxLength": 500},
    "reason_codes": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 50}},
    "field_changes": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["field_code", "value", "reported_text", "precision"], "properties": {"field_code": {"type": "string", "maxLength": 100}, "value": {}, "reported_text": {"type": ["string", "null"], "maxLength": 200}, "precision": {"enum": ["exact", "approximate", "range", "partial", "unknown"]}}}},
    "contents_item_changes": {"type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "description", "category", "quantity", "brand", "model", "loss_type", "ownership", "estimated_value", "reported_text"], "properties": {"item_id": {"type": ["string", "null"]}, "description": {"type": "string", "maxLength": 300}, "category": {"type": "string", "maxLength": 100}, "quantity": {"type": "integer", "minimum": 1}, "brand": {"type": ["string", "null"], "maxLength": 100}, "model": {"type": ["string", "null"], "maxLength": 100}, "loss_type": {"enum": ["damaged", "lost", "stolen", "destroyed"]}, "ownership": {"enum": ["owned", "leased", "borrowed", "gifted", "other"]}, "estimated_value": {"type": ["object", "null"]}, "reported_text": {"type": ["string", "null"], "maxLength": 200}}}},
    "next_question": {"type": ["object", "null"], "additionalProperties": false, "required": ["field_codes", "wording", "reason"], "properties": {"field_codes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "maxLength": 100}}, "wording": {"type": "string", "maxLength": 250}, "reason": {"enum": ["safety_first", "branch_just_activated", "blocks_creation", "clarify_conflict", "natural_follow_up"]}}},
    "service_suggestions": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["service_identity", "rationale"], "properties": {"service_identity": {"type": "string", "maxLength": 100}, "rationale": {"type": "string", "maxLength": 150}}}},
    "state_proposals": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["path", "to", "reason"], "properties": {"path": {"enum": ["claim_state.urgency", "claim_state.customer_support"]}, "to": {"type": "string", "maxLength": 50}, "reason": {"type": "string", "maxLength": 150}}}},
    "escalation": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"enum": ["urgent_safety", "human_requested", "accessibility", "distress", "professional_review"]}, "reason": {"type": "string", "maxLength": 150}}},
    "ready_to_create": {"type": "boolean"},
    "confirms_batch": {"type": "boolean"}
  }
}
