{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "record_and_ask",
        "clarify",
        "offer_service",
        "request_document",
        "obtain_document",
        "summarize",
        "propose_submit",
        "escalate",
        "answer_only"
      ],
      "type": "string"
    },
    "reply": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 50,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "field_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field_code": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "value": {},
          "reported_text": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "precision": {
            "enum": [
              "exact",
              "approximate",
              "range",
              "partial",
              "unknown"
            ],
            "type": "string"
          },
          "disposition": {
            "enum": [
              "value",
              "claimant_will_supply",
              "third_party_pending"
            ],
            "type": "string"
          },
          "service_identity": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "field_code",
          "value",
          "reported_text",
          "precision",
          "disposition",
          "service_identity"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "type": "array"
    },
    "contents_item_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "category": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "minimum": 1,
            "maximum": 999,
            "type": "integer"
          },
          "brand": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "loss_type": {
            "enum": [
              "damaged",
              "lost",
              "stolen",
              "destroyed"
            ],
            "type": "string"
          },
          "ownership": {
            "enum": [
              "owned",
              "leased",
              "borrowed",
              "gifted",
              "other"
            ],
            "type": "string"
          },
          "estimated_value": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "minimum": 0,
                    "maximum": 10000000,
                    "type": "number"
                  },
                  "currency": {
                    "description": "ISO 4217 code the claimant stated; NZD when they did not name a currency.",
                    "maxLength": 3,
                    "minLength": 3,
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  }
                },
                "required": [
                  "amount",
                  "currency"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "reported_text": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "description",
          "category",
          "loss_type",
          "ownership"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "type": "array"
    },
    "next_question": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "field_codes": {
              "items": {
                "minLength": 1,
                "maxLength": 100,
                "type": "string"
              },
              "maxItems": 3,
              "minItems": 1,
              "type": "array"
            },
            "wording": {
              "maxLength": 250,
              "minLength": 1,
              "type": "string"
            },
            "reason": {
              "enum": [
                "safety_first",
                "branch_just_activated",
                "blocks_creation",
                "clarify_conflict",
                "natural_follow_up"
              ],
              "type": "string"
            }
          },
          "required": [
            "field_codes",
            "wording",
            "reason"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "service_suggestions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "service_identity": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "rationale": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "claimant_request_quote": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The claimant's exact words asking for this service in the current message; null when they did not ask."
          }
        },
        "required": [
          "service_identity",
          "rationale",
          "claimant_request_quote"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "type": "array"
    },
    "document_requests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "document_kind": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "from_party": {
            "enum": [
              "claimant",
              "third_party"
            ],
            "type": "string"
          },
          "service_identity": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "document_kind",
          "from_party",
          "service_identity"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "type": "array"
    },
    "evidence_interpretations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "document_kind": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "document_kind"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "type": "array"
    },
    "summary_fields": {
      "anyOf": [
        {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_proposals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "enum": [
              "claim_state.urgency",
              "claim_state.customer_support"
            ],
            "type": "string"
          },
          "to": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "to",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "type": "array"
    },
    "escalation": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "urgent_safety",
                "human_requested",
                "accessibility",
                "distress",
                "professional_review"
              ],
              "type": "string"
            },
            "reason": {
              "maxLength": 150,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ready_to_create": {
      "type": "boolean"
    },
    "confirms_batch": {
      "type": "boolean"
    }
  },
  "required": [
    "action",
    "reply"
  ],
  "type": "object"
}
