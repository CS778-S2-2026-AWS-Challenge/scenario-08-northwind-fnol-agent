# Local prototype defaults. Do not place secrets in this file.
# Synthetic credentials are test-only. Normal runtime uses the persistent identity adapter.
NORTHWIND_ENVIRONMENT=development
NORTHWIND_IDENTITY_MODE=normal
NORTHWIND_IDENTITY_DB_PATH=.northwind-identity.sqlite3
NORTHWIND_STAFF_IDENTITY_DB_PATH=.northwind-staff-identity.sqlite3
NORTHWIND_CONTROL_PLANE_DB_PATH=.northwind-control-plane.sqlite3
DATA_RUNTIME_PROFILE=local_mvp
# fixture (no MongoDB, no MinIO, no persisted Evidence) exists only for the automated test
# suite. scripts/start-dev.ps1 is the only supported way to run the app locally; it sets
# every value below at process level for the backend it starts, so nothing here needs to be
# copied into an actual .env file for that path to work.
NORTHWIND_CORS_ALLOW_ORIGINS=*
NORTHWIND_CORS_ALLOW_CREDENTIALS=false
NORTHWIND_SYNTHETIC_CLAIMANT_TOKEN=synthetic-claimant
NORTHWIND_CLAIMANT_SESSION_TTL_MINUTES=30
NORTHWIND_STAFF_SESSION_TTL_MINUTES=480
# Intake triage: highest known loss (NZD) that can still be fast-track (#1136).
NORTHWIND_TRIAGE_AMOUNT_THRESHOLD_NZD=5000
NORTHWIND_SYNTHETIC_STAFF_TOKEN=synthetic-staff
NORTHWIND_SYNTHETIC_ADMIN_TOKEN=synthetic-admin
NORTHWIND_SYNTHETIC_RELEASE_APPROVER_TOKEN=synthetic-release-approver
NORTHWIND_SYNTHETIC_INTEGRATION_TOKEN=synthetic-integration

# Public claimant-client navigation target. Production may keep the same-origin default;
# local standalone development should point this at the running Workbench Vite origin.
VITE_NORTHWIND_WORKBENCH_URL=/workbench/

# Model-gateway configuration. The development runtime is model_gateway: the backend calls the
# shared model profile selected below. The controlled profile (a deterministic agent that never
# calls a model) exists only for CI and the test suite; do not use it for development.
AGENT_RUNTIME_PROFILE=model_gateway
MODEL_PROFILE_ID=openrouter-gpt4o-mini
MODEL_RUNTIME_BINDINGS_PATH=config/model-runtime-bindings.json
MODEL_TIMEOUT_SECONDS=180
# Provider, base URL, model identifier, prompt version and capability flags all come from the
# profile in MODEL_RUNTIME_BINDINGS_PATH. When that file is loaded the backend ignores
# MODEL_PROVIDER / MODEL_BASE_URL / MODEL_IDENTIFIER / MODEL_API_KEY_ENV / MODEL_SUPPORTS_*;
# change the model in config/model-runtime-bindings.json, not here.
#
# Credentials are pulled from the team secrets endpoint by scripts/start-dev.ps1 (see README).
# The names below are the binding contract only; never write their values into .env.
NORTHWIND_MODEL_API_KEY=
GEMINI_API_KEY=
NORTHWIND_QWEN_BASE_URL=
# Fernet key for separately protected bank and identity-document values.
# Generate and inject through the runtime secret mechanism; never commit the value.
NORTHWIND_PROTECTED_DATA_KEY=

# To run a different published profile, change MODEL_PROFILE_ID to another profile_id from
# config/model-runtime-bindings.json and make sure its credential is in the secrets bundle:
# MODEL_PROFILE_ID=google-gemini35-flash-lite   (needs GEMINI_API_KEY)
# MODEL_PROFILE_ID=bedrock-nova2-lite           (needs AWS_BEARER_TOKEN_BEDROCK; marked
#                                                unavailable until AWS account verification)
# MODEL_PROFILE_ID=qwen-local                   (needs NORTHWIND_QWEN_BASE_URL)

# S3-compatible object storage (used by the MinIO adapter; never commit real credentials).
NORTHWIND_OBJECT_STORAGE_ADAPTER=fixture
NORTHWIND_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Set this when the backend uses an internal endpoint that a claimant browser cannot reach.
NORTHWIND_OBJECT_STORAGE_PRESIGN_ENDPOINT=
NORTHWIND_OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
NORTHWIND_OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
NORTHWIND_OBJECT_STORAGE_BUCKET=northwind-evidence
NORTHWIND_OBJECT_STORAGE_REGION=us-east-1
NORTHWIND_OBJECT_STORAGE_PRESIGN_EXPIRY_SECONDS=900

# MongoDB persistence (required only for explicit MongoDB runtime verification).
# Replace the local URI through process configuration; never commit Atlas credentials.
NORTHWIND_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
NORTHWIND_MONGODB_DATABASE=northwind_fnol
NORTHWIND_MONGODB_COLLECTION=northwind_records
NORTHWIND_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Runnable and fail-closed deployment examples are maintained under deploy/runtime/.
# Use scripts/check_runtime_profile.py to validate one example before starting the API.
