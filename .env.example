# Local prototype defaults. Do not place secrets in this file.
# Synthetic credentials are test-only. Normal runtime uses the persistent identity adapter.
NORTHWIND_ENVIRONMENT=development
NORTHWIND_IDENTITY_MODE=normal
NORTHWIND_IDENTITY_DB_PATH=.northwind-identity.sqlite3
NORTHWIND_STAFF_IDENTITY_DB_PATH=.northwind-staff-identity.sqlite3
NORTHWIND_CONTROL_PLANE_DB_PATH=.northwind-control-plane.sqlite3
DATA_RUNTIME_PROFILE=fixture
# Use local_mvp only with the complete deploy/runtime/local-mvp.env.example configuration.
NORTHWIND_CORS_ALLOW_ORIGINS=*
NORTHWIND_CORS_ALLOW_CREDENTIALS=false
NORTHWIND_SYNTHETIC_CLAIMANT_TOKEN=synthetic-claimant
NORTHWIND_CLAIMANT_SESSION_TTL_MINUTES=30
NORTHWIND_STAFF_SESSION_TTL_MINUTES=480
NORTHWIND_STAFF_BOOTSTRAP_EMAIL=
NORTHWIND_STAFF_BOOTSTRAP_PASSWORD=
NORTHWIND_STAFF_BOOTSTRAP_DISPLAY_NAME=Northwind Claims Professional
NORTHWIND_SYNTHETIC_STAFF_TOKEN=synthetic-staff
NORTHWIND_SYNTHETIC_ADMIN_TOKEN=synthetic-admin
NORTHWIND_SYNTHETIC_RELEASE_APPROVER_TOKEN=synthetic-release-approver
NORTHWIND_SYNTHETIC_INTEGRATION_TOKEN=synthetic-integration

# Model-gateway configuration. MODEL_API_KEY_ENV names a separate secret environment
# variable; do not place the credential itself in this file.
AGENT_RUNTIME_PROFILE=controlled
MODEL_PROTOCOL_ADAPTER=openai_compatible
MODEL_PROFILE_ID=qwen-local
MODEL_PROVIDER=unconfigured
MODEL_PURPOSE=agent_turn
MODEL_PRIVACY_CLASS=synthetic_fnol
MODEL_PROMPT_VERSION=northwind-fnol-claimant-v7
MODEL_RUNTIME_BINDINGS_PATH=config/model-runtime-bindings.json
MODEL_EVALUATION_STATUS=configured
MODEL_BASE_URL=
MODEL_IDENTIFIER=
MODEL_API_KEY_ENV=
NORTHWIND_QWEN_BASE_URL=
# Store private local values with scripts/manage-local-secrets.ps1. These names are listed here
# only as the binding contract; do not write their values into .env.
NORTHWIND_MODEL_API_KEY=
GEMINI_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_SUPPORTS_STRUCTURED_OUTPUT=true
MODEL_SUPPORTS_TOOLS=false
MODEL_SUPPORTS_IMAGE_INPUT=false
MODEL_SUPPORTS_DOCUMENT_INPUT=false

# Bedrock Converse uses a provider-specific adapter rather than the OpenAI-compatible route.
# Supply AWS_BEARER_TOKEN_BEDROCK through the runtime secret mechanism and point
# MODEL_API_KEY_ENV at that variable. The region endpoint and authorised model remain
# deployment choices; do not claim availability until a live invocation succeeds.
# MODEL_PROTOCOL_ADAPTER=bedrock_converse
# MODEL_PROFILE_ID=bedrock-nova2-lite
# MODEL_BASE_URL=https://bedrock-runtime.ap-southeast-2.amazonaws.com
# MODEL_IDENTIFIER=global.amazon.nova-2-lite-v1:0
# MODEL_API_KEY_ENV=AWS_BEARER_TOKEN_BEDROCK

# Google Gemini uses the native GenerateContent protocol. Supply GEMINI_API_KEY
# through the runtime secret mechanism; the checked-in binding stores only its name.
# MODEL_PROTOCOL_ADAPTER=google_generate_content
# MODEL_PROFILE_ID=google-gemini35-flash-lite
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# MODEL_IDENTIFIER=gemini-3.5-flash-lite
# MODEL_API_KEY_ENV=GEMINI_API_KEY

# S3-compatible object storage (used by the MinIO adapter; never commit real credentials).
NORTHWIND_OBJECT_STORAGE_ADAPTER=fixture
NORTHWIND_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Set this when the backend uses an internal endpoint that a claimant browser cannot reach.
NORTHWIND_OBJECT_STORAGE_PRESIGN_ENDPOINT=
NORTHWIND_OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
NORTHWIND_OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
NORTHWIND_OBJECT_STORAGE_BUCKET=northwind-evidence
NORTHWIND_OBJECT_STORAGE_REGION=us-east-1
NORTHWIND_OBJECT_STORAGE_PRESIGN_EXPIRY_SECONDS=900

# MongoDB persistence (required only for explicit MongoDB runtime verification).
# Replace the local URI through process configuration; never commit Atlas credentials.
NORTHWIND_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
NORTHWIND_MONGODB_DATABASE=northwind_fnol
NORTHWIND_MONGODB_COLLECTION=northwind_records
NORTHWIND_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Runnable and fail-closed deployment examples are maintained under deploy/runtime/.
# Use scripts/check_runtime_profile.py to validate one example before starting the API.
