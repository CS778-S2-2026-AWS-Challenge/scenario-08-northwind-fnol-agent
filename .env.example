# Local prototype defaults. Do not place secrets in this file.
NORTHWIND_ENVIRONMENT=development
DATA_RUNTIME_PROFILE=fixture
NORTHWIND_CORS_ALLOW_ORIGINS=*
NORTHWIND_CORS_ALLOW_CREDENTIALS=false
NORTHWIND_SYNTHETIC_CLAIMANT_TOKEN=synthetic-claimant
NORTHWIND_SYNTHETIC_INTEGRATION_TOKEN=synthetic-integration

# S3-compatible object storage (used by the MinIO adapter; never commit real credentials).
NORTHWIND_OBJECT_STORAGE_ADAPTER=fixture
NORTHWIND_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
NORTHWIND_OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
NORTHWIND_OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
NORTHWIND_OBJECT_STORAGE_BUCKET=northwind-evidence
NORTHWIND_OBJECT_STORAGE_REGION=us-east-1
NORTHWIND_OBJECT_STORAGE_PRESIGN_EXPIRY_SECONDS=900
