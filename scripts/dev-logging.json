{"version":1,"disable_existing_loggers":false,
 "formatters":{"f":{"format":"%(asctime)s %(levelname)s %(name)s %(message)s | %(diagnostic)s %(error_code)s %(rejection)s %(problems)s %(words_reviewed)s","defaults":{"diagnostic":"","error_code":"","rejection":"","problems":"","words_reviewed":""}}},
 "handlers":{"h":{"class":"logging.StreamHandler","formatter":"f","stream":"ext://sys.stdout"}},
 "root":{"level":"INFO","handlers":["h"]},
 "loggers":{"uvicorn.access":{"level":"INFO","handlers":["h"],"propagate":false}}}
