# Candidate profile. Startup is intentionally refused until the complete MongoDB bundle is verified.
NORTHWIND_ENVIRONMENT=development
DATA_RUNTIME_PROFILE=mongodb
NORTHWIND_OBJECT_STORAGE_ADAPTER=s3_compatible
AGENT_RUNTIME_PROFILE=controlled
NORTHWIND_MONGODB_URI=mongodb://mongodb:27017/?replicaSet=rs0
NORTHWIND_MONGODB_DATABASE=northwind_fnol
NORTHWIND_MONGODB_COLLECTION=northwind_records
NORTHWIND_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
NORTHWIND_OBJECT_STORAGE_ENDPOINT=http://minio:9000
NORTHWIND_OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
NORTHWIND_OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
NORTHWIND_OBJECT_STORAGE_BUCKET=northwind-evidence
NORTHWIND_OBJECT_STORAGE_REGION=us-east-1
