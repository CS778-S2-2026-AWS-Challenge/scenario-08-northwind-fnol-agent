# Reserved AWS data-runtime profile. Startup remains refused until a bounded
# provider implementation and real runtime evidence exist.
# The verified AWS result covers only private S3-to-CloudFront static delivery;
# it does not enable this data-runtime profile.
NORTHWIND_ENVIRONMENT=development
DATA_RUNTIME_PROFILE=aws
NORTHWIND_OBJECT_STORAGE_ADAPTER=fixture
AGENT_RUNTIME_PROFILE=controlled
# With AGENT_RUNTIME_PROFILE=model_gateway, also set MODEL_PROFILE_ID and PDF_MODEL_PROFILE_ID
# (the published profile that reads PDF evidence); the controlled agent needs neither.
