# Reserved complete AWS data-runtime profile. Startup remains refused.
# The fixed first AWS deployment keeps MongoDB and MinIO on an EC2-hosted Compose stack and uses
# private S3-to-CloudFront only for static clients. It does not select this profile.
NORTHWIND_ENVIRONMENT=development
DATA_RUNTIME_PROFILE=aws
NORTHWIND_OBJECT_STORAGE_ADAPTER=fixture
AGENT_RUNTIME_PROFILE=controlled
